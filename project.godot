; Engine configuration file.
; Crusade — Isometric Map Engine & Editor Framework (V2)

config_version=5

[application]

config/name="Crusade"
config/description="Isometric map engine & in-game editor (codename Crusade). High-res, SC2-style 2D isometric."
run/main_scene="res://src/nodes/map_system.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
; default_texture_filter=1 is Linear (no mipmaps). Kept at 1 rather than 2
; (Linear+Mipmap) deliberately: the terrain TileSet packs tiles adjacent in a
; single atlas with zero separation, so mipmapping would bleed neighbouring
; atlas regions into each other and show seams when zoomed out (zoom range is
; [0.5, 2.5]). World TileMapLayers that need mipmaps should opt in per-texture
; via the atlas import settings instead of flipping this global default, which
; would also affect future UI. Linear filtering still gives the HD, non-pixel
; look; snapping stays OFF below for the same reason.
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false

