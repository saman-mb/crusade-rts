; Engine configuration file.
; Crusade — Isometric Map Engine & Editor Framework (V2)

config_version=5

[application]

config/name="Crusade"
config/description="Isometric map engine & in-game editor (codename Crusade). High-res, SC2-style 2D isometric."
run/main_scene="res://src/nodes/map_system.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false

