# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Import sidecars + resource UIDs: regenerated by `godot --import` (CI wipes
# .godot and reimports fresh), so they are build output, not tracked source.
*.import
*.uid

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build artifacts / exports
/build/
/export/
*.tmp

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python tooling
__pycache__/
*.pyc

# Integration harness screenshots/logs (tools/harness/README.md) -- output, not source
tools/shots/*
!tools/shots/.gitkeep
